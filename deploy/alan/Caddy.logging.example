# Merge this format into the existing site's log block. Do not duplicate it.
format filter {
    wrap json
    fields {
        request>headers>Authorization delete
        request>headers>Cookie delete
        request>headers>Referer delete
        resp_headers>Set-Cookie delete
        request>uri query {
            delete token
            delete access_token
            # Auth redirects can nest the original token-bearing URL in rd.
            delete rd
            delete code
            delete state
        }
    }
}
