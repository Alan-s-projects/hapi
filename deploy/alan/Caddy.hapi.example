# Insert INSIDE the existing HTTPS site, before its catch-all handler, only
# after enrollment, VM hardening approval and authentication/expiry testing.
# Caddy must join hapi-gateway_front; preserve its existing network and volumes.
# Do not strip /hapi: the patched application consumes its own base path.
@hapi_auth path /auth /auth/*
handle @hapi_auth {
    reverse_proxy hapi-authelia:9091
}
@hapi_app path /hapi /hapi/*
handle @hapi_app {
    route {
        @gateway_session path /hapi/.gateway/session
        handle @gateway_session {
            header Cache-Control "no-store"
            header X-Hapi-Gateway-Session "protected"
            route {
                forward_auth hapi-authelia:9091 {
                    uri /api/authz/forward-auth
                    header_up Accept "application/json"
                }
                respond 204
            }
        }
        handle {
            forward_auth hapi-authelia:9091 {
                uri /api/authz/forward-auth
            }
            reverse_proxy hapi-frps:13006 {
                header_up -Cookie
                flush_interval -1
                stream_timeout 1m
                stream_close_delay 5s
            }
        }
    }
}
# Pair the WebSocket limit with HAPI_SSE_MAX_CONNECTION_SECONDS=60 on the hub.
# Required before activation: redact Authorization, Cookie and token query
# parameters in the site's access-log encoder, and verify MFA-expiry behavior
# for fetch/SSE/WebSocket clients. This fragment is not a full site config.
